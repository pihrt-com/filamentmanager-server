Options -Indexes
RewriteEngine On

# Preserve Bearer credentials on Apache/FastCGI hosts that do not expose
# Authorization as HTTP_AUTHORIZATION automatically.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:app|config|database|resources|routes|storage|tests|tools)(?:/|$) - [F,L,NC]
RewriteRule ^(?:README|CHANGELOG|LICENSE|VERSION)(?:\.|$) - [F,L,NC]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^(?:\.env|local\.php|.*\.(?:log|sql|zip))$">
    Require all denied
</FilesMatch>
